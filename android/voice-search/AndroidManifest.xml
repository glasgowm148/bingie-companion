<?xml version="1.0" encoding="utf-8"?>
<!-- Kodi voice search: the Shield remote's mic button (Android's assist key) searches in Kodi.

     Android 11 never passes the assist key to apps: it launches the app holding the ASSISTANT
     role. This app takes that role, listens with the device's speech service and puts the words
     into Kodi's search through Kodi Manager (or into the search of the app that was in front,
     when that app has one, e.g. SmartTube). -->
<manifest xmlns:android="http://schemas.android.com/apk/res/android"
    package="io.github.glasgowm148.kodivoice"
    android:versionCode="2"
    android:versionName="0.1.1">

    <uses-sdk android:minSdkVersion="26" android:targetSdkVersion="30" />

    <uses-permission android:name="android.permission.RECORD_AUDIO" />
    <!-- Only for Kodi Manager on 127.0.0.1. -->
    <uses-permission android:name="android.permission.INTERNET" />

    <uses-feature android:name="android.software.leanback" android:required="false" />
    <uses-feature android:name="android.hardware.touchscreen" android:required="false" />
    <uses-feature android:name="android.hardware.microphone" android:required="false" />

    <queries>
        <intent><action android:name="android.speech.RecognitionService" /></intent>
        <intent><action android:name="android.intent.action.SEARCH" /></intent>
        <package android:name="org.xbmc.kodi" />
    </queries>

    <application
        android:label="Kodi voice search"
        android:allowBackup="false"
        android:usesCleartextTraffic="true">

        <activity
            android:name=".AssistActivity"
            android:exported="true"
            android:excludeFromRecents="true"
            android:launchMode="singleTask"
            android:taskAffinity=""
            android:theme="@android:style/Theme.Translucent.NoTitleBar">
            <!-- From the skin or companion (Kodi's StartAndroidActivity). Any app may start this, so
                 the app ignores EXTRA_ASSIST_PACKAGE here and the words always go to Kodi Manager. -->
            <intent-filter>
                <action android:name="io.github.glasgowm148.kodivoice.LISTEN" />
                <category android:name="android.intent.category.DEFAULT" />
            </intent-filter>
        </activity>

        <!-- The mic button, once this app holds the ASSISTANT role. Android starts the assistant from
             system_server with its identity cleared, which holds DUMP; ordinary apps do not, so only
             this entry point's EXTRA_ASSIST_PACKAGE (the app in front) is trusted. -->
        <activity-alias
            android:name=".SystemAssist"
            android:targetActivity=".AssistActivity"
            android:exported="true"
            android:permission="android.permission.DUMP">
            <intent-filter>
                <action android:name="android.intent.action.ASSIST" />
                <category android:name="android.intent.category.DEFAULT" />
            </intent-filter>
        </activity-alias>

        <activity android:name=".ConfigActivity" android:exported="true" android:label="Kodi voice search setup" android:theme="@android:style/Theme.Material.NoActionBar">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
                <category android:name="android.intent.category.LEANBACK_LAUNCHER" />
            </intent-filter>
        </activity>

        <!-- Kodi Manager's port and token, set over adb: only the shell (DUMP) may send it. -->
        <receiver
            android:name=".ConfigReceiver"
            android:exported="true"
            android:permission="android.permission.DUMP">
            <intent-filter>
                <action android:name="io.github.glasgowm148.kodivoice.CONFIGURE" />
            </intent-filter>
        </receiver>
    </application>
</manifest>
